# ---- Datasets / large files ----
# Keep large raw data OUT of git history (use Git LFS or external storage instead).
# Folder structure is preserved via .gitkeep files.
data/raw/*
data/processed/*
!data/**/.gitkeep
results/*
!results/.gitkeep

# Large/binary data formats (track with Git LFS if you must version them)
*.csv
# Exception: tiny PUBLIC label/metadata + reference feature files for CV/fusion.
!data/labels.csv
!data/MIPDB_PublicFile.csv
!data/eye_features.csv
# Track small result CSVs/JSON (AUCs, predictions, operating-point) for the record
# (placed after *.csv so the exception wins). Large artifacts (tarballs) stay out.
!results/*.csv
!results/*.json
# Per-participant OOF probs for the 12 baselines (tiny; needed for offline DeLong
# pairwise + operating-point analyses via scripts/analyze_clinical.py).
!results/oof_table2.pkl
*.tsv
*.xlsx
*.parquet
*.feather
*.h5
*.hdf5
*.zip
*.7z
*.tar
*.tar.gz
*.db
*.sqlite

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
*.egg-info/

# ---- Node ----
node_modules/
dist/
build/

# ---- Environment / secrets ----
.env
.env.*
*.key
*.pem
credentials.json

# ---- SLURM / cluster job logs ----
*.out
*.log
slurm-*.out

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- Large local data caches (multi-GB; regenerated by the pipeline, never commit) ----
data/mipdb_raw/
data/ds003478/
data/ds2_features/
data/resting_features/
data/task_features/
data/aligned/
data/aligned_resting/
data/aligned_task/

# ---- Stray 0-byte files from botched shell commands ----
/129
/190
/198
/=15:
/PYEOF
/break
/if
/lat90
